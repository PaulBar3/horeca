# === Django ===
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_ALLOWED_HOSTS=foodbase.by,www.foodbase.by
DJANGO_TIME_ZONE=Europe/Minsk
DJANGO_LANGUAGE_CODE=ru

# === PostgreSQL ===
# На VPS пароль подставляется compose в DATABASE_URL — используйте простые
# символы: латиница, цифры, _ - (без @ : / # и пробелов)
POSTGRES_DB=foodcore
POSTGRES_USER=foodcore
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Gunicorn ===
GUNICORN_WORKERS=3
LOG_LEVEL=info

# === VPS / Docker ===
# Email для уведомлений Let's Encrypt (Caddy)
ACME_EMAIL=admin@foodbase.by
# Пароль суперпользователя admin при первом создании (сменить после первого входа!)
# ADMIN_PASSWORD=admin123

# === Security (production) ===
# SECURE_SSL_REDIRECT=True

# === Email (optional) ===
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@foodbase.by
