}

# Основной домен + www: авто-TLS, реверс-прокси на gunicorn
foodbase.by, www.foodbase.by {
	# Верификация Google Search Console (файл смонтирован в /srv/gsc)
	handle /googledfb032ac7a653f69.html {
		root * /srv/gsc
		file_server
	}

	reverse_proxy web:8000
}
